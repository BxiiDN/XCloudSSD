<UserControl x:Class="XCloudSSD.Desktop.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:XCloudSSD.Desktop.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="{Binding [NavAccounts], Source={x:Static i:Loc.Instance}}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,16" Text="{Binding [AccountsSub], Source={x:Static i:Loc.Instance}}" />
            <WrapPanel Margin="0,0,0,16">
                <Button Style="{DynamicResource AccentButton}" Margin="0,0,8,0" Click="AddGoogle_Click"
                        Content="{Binding [AddGoogle], Source={x:Static i:Loc.Instance}}" />
                <Button Click="AddTeraBox_Click" Content="{Binding [AddTeraBox], Source={x:Static i:Loc.Instance}}" />
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="Empty" DockPanel.Dock="Top" Style="{StaticResource Dim}" Visibility="Collapsed"
                   Text="{Binding [NoAccountsYet], Source={x:Static i:Loc.Instance}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource ToolButton}" Tag="{Binding Id}" Click="Info_Click"
                                            Content="{Binding [Info], Source={x:Static i:Loc.Instance}}" />
                                    <Button Style="{DynamicResource ToolButton}" Tag="{Binding Id}" Click="Rename_Click"
                                            Content="{Binding [Rename], Source={x:Static i:Loc.Instance}}" />
                                    <Button Style="{DynamicResource ToolButton}" Tag="{Binding Id}" Click="Toggle_Click"
                                            Content="{Binding ToggleText}" />
                                    <Button Style="{DynamicResource ToolButton}" Tag="{Binding Id}" Click="Reconnect_Click"
                                            Content="{Binding [ReconnectNow], Source={x:Static i:Loc.Instance}}" />
                                    <Button Style="{DynamicResource ToolButton}" Tag="{Binding Id}" Click="Remove_Click"
                                            Content="{Binding [Remove], Source={x:Static i:Loc.Instance}}" />
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Email}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Style="{StaticResource Dim}">
                                        <Run Text="{Binding Provider, Mode=OneWay}" /> · <Run Text="{Binding Title, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
