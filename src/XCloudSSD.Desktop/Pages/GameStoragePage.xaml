<UserControl x:Class="XCloudSSD.Desktop.Pages.GameStoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:XCloudSSD.Desktop.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding [NavGames], Source={x:Static i:Loc.Instance}}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,16" Text="{Binding [GamesSub], Source={x:Static i:Loc.Instance}}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{Binding [GamesHonestTitle], Source={x:Static i:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Dim}" Text="{Binding [GamesHonestBody], Source={x:Static i:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <ComboBox x:Name="DriveBox" Width="260" DisplayMemberPath="Title" SelectionChanged="DriveBox_SelectionChanged" />
                        <Button Margin="8,0,0,0" Click="Rescan_Click" HorizontalAlignment="Left" Content="{Binding [Rescan], Source={x:Static i:Loc.Instance}}" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Style="{DynamicResource ToolButton}" Click="CreateSteam_Click" Content="{Binding [CreateSteamLibrary], Source={x:Static i:Loc.Instance}}" />
                        <Button Style="{DynamicResource ToolButton}" Click="OpenSteam_Click" Content="{Binding [OpenSteamStorage], Source={x:Static i:Loc.Instance}}" />
                        <Button Style="{DynamicResource ToolButton}" Click="CreateGames_Click" Content="{Binding [CreateGamesFolder], Source={x:Static i:Loc.Instance}}" />
                        <Button Style="{DynamicResource ToolButton}" Click="Check_Click" Content="{Binding [RunStorageCheck], Source={x:Static i:Loc.Instance}}" />
                    </WrapPanel>
                    <TextBlock x:Name="SteamInfo" Style="{StaticResource Dim}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{Binding [InstalledGames], Source={x:Static i:Loc.Instance}}" />
                    <ListView x:Name="Games" MinHeight="120" MaxHeight="360">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="320" Header="{Binding [ColName], Source={x:Static i:Loc.Instance}}" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Width="90" Header="App ID" DisplayMemberBinding="{Binding AppId}" />
                                <GridViewColumn Width="110" Header="{Binding [ColSize], Source={x:Static i:Loc.Instance}}" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Width="140" Header="{Binding [ColState], Source={x:Static i:Loc.Instance}}" DisplayMemberBinding="{Binding StateText}" />
                                <GridViewColumn Width="360" Header="{Binding [ColLocation], Source={x:Static i:Loc.Instance}}" DisplayMemberBinding="{Binding Folder}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{Binding [StorageCheck], Source={x:Static i:Loc.Instance}}" />
                    <TextBox x:Name="CheckOutput" IsReadOnly="True" MinHeight="140" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
