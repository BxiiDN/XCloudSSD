<UserControl x:Class="XCloudSSD.Desktop.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:XCloudSSD.Desktop.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding [NavDashboard], Source={x:Static i:Loc.Instance}}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,20" Text="{Binding [DashboardSub], Source={x:Static i:Loc.Instance}}" />

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatTotalDisks], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="TotalDisks" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatConnected], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="Connected" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatMounted], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="Mounted" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatActiveTransfers], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="Transfers" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatTotalCapacity], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="Capacity" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatUsed], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="Used" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatAvailable], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="Available" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [StatConnection], Source={x:Static i:Loc.Instance}}" />
                        <TextBlock x:Name="Connection" Style="{StaticResource StatValue}" Text="—" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Style="{StaticResource H2}" Margin="0,12,0,10" Text="{Binding [NavDisks], Source={x:Static i:Loc.Instance}}" />
            <ItemsControl x:Name="DiskList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Letter}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" FontSize="12" />
                                    <ProgressBar Style="{DynamicResource Meter}" Value="{Binding UsedFraction, Mode=OneWay}" />
                                    <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Dim}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding StateBrush}" Margin="16,0,0,0" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoDisks" Style="{StaticResource Dim}" Visibility="Collapsed" Text="{Binding [NoDisksYet], Source={x:Static i:Loc.Instance}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
